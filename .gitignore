# dependencies / build output
node_modules/
out/
dist/

# audio VO cache (regenerable)
**/scripts/.vo_cache/

# secrets — never commit API keys
*.key
.env
.env.*
**/openrouter*key*

# os / editor
.DS_Store
*.log

# python bytecode
__pycache__/
*.py[cod]

# generated audio master (rebuild with `npm run audio`)
**/public/audio/

# stray root lockfile — there is no root package.json; the template has its own
/package-lock.json

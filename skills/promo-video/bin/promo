#!/usr/bin/env python3
"""Launcher for the promo engine: `promo <command>` from any directory."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "engine"))
if sys.version_info < (3, 11):
    sys.exit("promo needs Python 3.11 or newer")

from promo_engine.cli import main  # noqa: E402

sys.exit(main())
